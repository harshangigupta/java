import java.util.*;
class rotate270
{
    int m,n,sum,a[][];
void accept()
{
    Scanner sc=new Scanner(System.in);
    System.out.println("ENTER THE NUMBER OF ROWS AND COLUMS");
    m=sc.nextInt();
    n=sc.nextInt();
    a=new int[m][n];
    if(m>9||m<3||n>9||n<3)
    {
        System.out.println("INVALID INPUT");
        System.exit(0);
    }
    System.out.println("ENTER THE VALUES OF THE ARRAY");
    for (int i=0;i<m;i++)
    {
        for(int j=0;j<n;j++)
        a[i][j]=sc.nextInt();
    }
}
void display()
{
    System.out.println("ORIGINAL MATRIX");
    for (int i=0;i<m;i++)
    {
        for(int j=0;j<n;j++)
        {
        System.out.print(a[i][j]+"\t");
        if(a[i][j]%2==1)
        sum=sum+a[i][j];
    }
    System.out.println("");
}
}
void rotate270()
{
     System.out.println("ROTATED MATRIX (270 ANTU CLOCKWISE ROTATION)");
    for (int i=0;i<n;i++)
    {
        for(int j=m-1;j>=0;j--)
        System.out.print(a[j][i]+"\t");
        System.out.println("");
    }
    System.out.print("sum="+sum);
}
public static void main(String args[])
{
rotate270 ob=new rotate270();
ob.accept();
ob.display();
ob.rotate270();
}
}

