  void mirror2DArray(int[][] arr) 
  {
    for (int i = 0; i < arr.length; i++) {
      int left = 0, right = arr[i].length - 1;
      while (left < right) {
        int temp = arr[i][left];
        arr[i][left] = arr[i][right];
        arr[i][right] = temp;
        left++;
        right--;
      }
    }
  }

